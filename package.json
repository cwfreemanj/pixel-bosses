{
  "name": "pixel-bosses-mobile",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Pixel Bosses card battler with Capacitor Android and Railway multiplayer",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:server": "node scripts/smoke-server.mjs",
    "android:add": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "cors": "^2.8.5",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "stripe": "^18.5.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=20"
  }
}
