PORT=3000
DATABASE_URL=
PUBLIC_SERVER_URL=https://web-production-efaa4b.up.railway.app
ALLOWED_ORIGINS=*

# GetFirstPage.com link-code verifier. It must accept the JSON contract in DEPLOYMENT.md.
GFP_VERIFY_URL=
GFP_API_TOKEN=

# Stripe Checkout (direct web/sideload distribution). Play Store builds need Google Play Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SPARK=
STRIPE_PRICE_BOSS=
STRIPE_PRICE_RIFT=
STRIPE_PRICE_COSMOS=

# Polygon card minting. Start with Amoy; never commit the private key.
MINT_RPC_URL=https://rpc-amoy.polygon.technology
MINT_PRIVATE_KEY=
MINT_CONTRACT_ADDRESS=
MINT_CONFIRMATIONS=1
